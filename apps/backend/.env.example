# ── 실행 · 로그 ─────────────────────────────────────────────────
# medusa start 는 NODE_ENV 를 production 으로 스스로 설정한다.
# NODE_ENV 가 dev 로 시작하지 않으면 콘솔 로그가 JSON 이 된다.
PORT=9000
LOG_LEVEL=http

# ── 데이터베이스 ────────────────────────────────────────────────
# 사용자 · 데이터베이스 이름은 APP/01 의 compose.local.yaml 값이고,
# 비밀번호는 같은 파일의 POSTGRES_PASSWORD 를 넣는다.
DATABASE_URL=postgres://medusa:CHANGE_ME@localhost:5432/commerce
DB_NAME=commerce
# TLS 는 DB_SSL 하나로 정한다. DATABASE_URL 에 sslmode 같은 TLS 매개변수를 붙이면 기동이 멈춘다.
# true 면 DB_SSL_CA_FILE 이 가리키는 CA 묶음으로 서버 인증서를 검증한다 (이미지에는 RDS CA 묶음의 경로가 들어 있다).
DB_SSL=false
# 복제본 최대 수 × DB_POOL_MAX + 마이그레이션 Job + 사람 ≤ max_connections × 0.8
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Redis (모듈 4개 + 세션 저장소) ───────────────────────────────
REDIS_URL=redis://localhost:6379

# ── 시크릿 (production 에서 비어 있으면 기동이 멈춘다) ─────────────
JWT_SECRET=
COOKIE_SECRET=

# ── HTTP 경계 · 관리자 UI (APP/01 이 정한 목록 그대로) ────────────
STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:5173,http://localhost:9000
# 관리자 UI 번들을 만들 때(medusa develop · medusa build) 구워지는 주소다. 이미지 build 는 이 값을 주지 않아
# "/"(번들을 내려 준 origin)로 굽는다 — 실행 시점에 값을 바꿔도 이미 만든 번들은 바뀌지 않는다.
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_WORKER_MODE=shared

# ── S3 파일 모듈 (S3_BUCKET 이 비면 모듈을 싣지 않는다) ────────────
# APP/01 의 FILE_S3_ENABLED 는 여기서 폐기한다 — 조건이 S3_BUCKET 으로 바뀌었다.
AWS_REGION=ap-northeast-2
S3_BUCKET=
S3_FILE_URL=
S3_PREFIX=media/

# ── 계측 (비우면 register() 가 계측을 켜지 않는다) ────────────────
OTEL_SERVICE_NAME=commerce-api
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_RESOURCE_ATTRIBUTES=
